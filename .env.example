# Set these as environment variables on your Trigger.dev project (dashboard or API),
# NOT committed. This file documents the names only.

# Tailscale auth key for the deployed tasks: ephemeral + reusable + tagged `tag:trigger`.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# The private Postgres, reachable only over the tailnet.
# PGHOST is the resource's 100.x tailnet IP or its full MagicDNS name.
PGHOST=100.x.y.z
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=app

# Optional: a private ClickHouse HTTP endpoint reachable over the tailnet.
# CLICKHOUSE_URL=http://100.x.y.z:8123

# Optional overrides.
# TS_HOSTNAME=trigger-task
# TS_LOGIN_SERVER=https://headscale.example.com
