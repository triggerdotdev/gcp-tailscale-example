# Set these as environment variables on your Trigger.dev project (dashboard or
# API), NOT committed. This file documents the names only. Set the Tailscale
# vars for the tailscale task, or the WireGuard vars for the WireGuard task.

# --- Shared: the private Postgres reached through the tunnel ---
# PGHOST is the private resource's address as seen from inside the tunnel: a
# tailnet IP / MagicDNS name (Tailscale), the WireGuard server's own address, or
# a managed resource's private IP when the server acts as a subnet router.
PGHOST=10.0.0.10
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=app

# --- Tailscale task ---
# Ephemeral + reusable + tagged (tag:trigger) auth key.
TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx
# Optional: point at a self-hosted Headscale control plane.
# TS_LOGIN_SERVER=https://headscale.example.com

# --- WireGuard task ---
WG_PRIVATE_KEY=<client wireguard private key>
WG_SERVER_PUBLIC_KEY=<server wireguard public key>
WG_ENDPOINT=<server public ip>:51820
# Comma-separated. Include the server's WG address, plus any subnet-routed
# private IPs (e.g. a managed database) you want to reach through the tunnel.
WG_ALLOWED_IPS=10.9.0.1/32
# Optional overrides.
# WG_ADDRESS=10.9.0.2/32
